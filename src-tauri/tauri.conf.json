{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNDB-GUI",
  "version": "1.0.1",
  "identifier": "com.vndb.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VNDB 文件名生成器",
        "width": 960,
        "height": 820,
        "minWidth": 840,
        "minHeight": 740,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
